# Application Configuration
APP_NAME=AIRGUARD
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated origins or JSON array allowed to talk to backend)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","http://127.0.0.1:8080","http://localhost:8000","http://127.0.0.1:8000","http://127.0.0.1:3000","http://127.0.0.1:5500"]

# Google APIs Configuration
# Set GOOGLE_MAPS_API_KEY to enable Google Routes API and Google Air Quality API.
# You can optionally set distinct keys for each API if preferred.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_here
# GOOGLE_AIR_QUALITY_API_KEY=your_google_air_quality_api_key_here

# Routing Configuration
ROUTING_TIMEOUT_SECONDS=10.0
ROUTING_MAX_SAMPLE_POINTS=8

